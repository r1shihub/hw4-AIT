<form method="POST" action="/quiz">
  <label for="answer">{{question}}</label>
  <input type="text" id="answer" name="answer", value="{{answer}}">
  <input type="hidden" name="id" value="{{id}}">
  <button type="submit">Submit</button>
</form>
{{#if status}}
  <p>Status: {{status}}</p>
  <p>{{{corrections}}}</p>
{{/if}}