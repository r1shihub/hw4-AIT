<form method="GET" action="/questions">
  <label for="answer">Search for question: </label>
  <input type="text" id="answer" name="answer", placeholder="Search questions">
  <button type="submit">Submit</button>
</form>
{{#if keyword}}
  <p>Showing results for "{{keyword}}"</p>
{{/if}}
<section class="questions">
  {{#each questions}}
    <article class="question">
      <h3>{{question}}</h3>
      <p class="genre">Genre: {{genre}}</p>
      <ul class="answers">
        {{#each answers}}
          <li>{{this}}</li>
        {{/each}}
      </ul>
    </article>
  {{else}}
    <p>No questions yet.</p>
  {{/each}}
</section>

<form method="POST" action="/questions">
  <label for="answer">Add new question: </label>
  <input type="text" id="newQuestion" name="newQuestion", placeholder="Question">
  <input type="text" id="newGenre" name="newGenre", placeholder="Genre">
  <input type="text" id="newAnswer" name="newAnswer", placeholder="Answer">
  <button type="submit">Submit</button>
</form>